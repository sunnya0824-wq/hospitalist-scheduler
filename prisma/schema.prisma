// Hospitalist Scheduler — Prisma schema
// PostgreSQL datasource. Run `prisma migrate dev` locally and
// `prisma migrate deploy` in production (handled by the start script).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Every shift template belongs to one category. Categories drive eligibility
// (admit/night flags), per-category min/max targets, fairness and the
// post-night rest rule. Names, hours and counts are fully configurable.
enum ShiftCategory {
  DAY
  ADMIT
  NIGHT
}

enum ShiftPreference {
  MORE
  FEWER
  NEUTRAL
}

enum AvailabilityType {
  UNAVAILABLE
  PREFERRED
}

enum ScheduleStatus {
  DRAFT
  GENERATED
  PUBLISHED
}

model Physician {
  id             String          @id @default(cuid())
  fullName       String
  active         Boolean         @default(true)
  desiredShifts  Int             @default(14)
  minShifts      Int             @default(0)
  maxShifts      Int             @default(20)
  minRounding    Int             @default(0)
  maxRounding    Int             @default(20)
  minNights      Int             @default(0)
  maxNights      Int             @default(8)
  minAdmin       Int             @default(0)
  maxAdmin       Int             @default(8)
  shiftPreference ShiftPreference @default(NEUTRAL)
  nightEligible  Boolean         @default(true)
  adminEligible  Boolean         @default(true)
  // Fractional appointment (1.0 = full time). Scales the auto-computed target.
  fteMultiplier      Decimal     @default(1.0)
  // Explicit per-month shift target. Null → round(monthlyAvg * fteMultiplier).
  monthlyShiftTarget Int?
  // Hard cap on consecutive working days across all hospitals.
  maxConsecutiveDays Int         @default(7)
  // Hard cap on nights worked back to back in one block.
  maxConsecutiveNights Int       @default(7)
  // Preferred night block length; null = organization default.
  preferredNightBlock  Int?
  // Opaque token for the personal ICS calendar feed.
  icsToken       String          @unique @default(cuid())
  notes          String?

  // --- Soft scheduling preferences (strongly weighted, never hard) ---
  // Direction preferences. prefersX and avoidsX are mutually exclusive
  // (enforced in the API and UI); both false = neutral.
  prefersNights      Boolean @default(false)
  avoidsNights       Boolean @default(false)
  prefersWeekends    Boolean @default(false)
  avoidsWeekends     Boolean @default(false)
  prefersDayAdmit    Boolean @default(false)
  avoidsDayAdmit     Boolean @default(false)
  // Per-weekday avoid map: { "0": true, ... } where 0 = Sunday … 6 = Saturday.
  avoidWeekdays  Json    @default("{}")
  // Soft monthly caps (null = no cap). Scheduler avoids exceeding unless forced.
  maxNightsPerMonth   Int?
  maxWeekendsPerMonth Int?

  availability    PhysicianAvailability[]
  preferences     PhysicianPreference[]
  assignments     ShiftAssignment[]
  timeOffRequests TimeOffRequest[]
  // Sites this physician may work beyond those open to everyone.
  locations       PhysicianLocation[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model TimeOffRequest {
  id          String    @id @default(cuid())
  physician   Physician @relation(fields: [physicianId], references: [id], onDelete: Cascade)
  physicianId String
  date        DateTime // date-only, midnight UTC of the requested day off
  note        String?
  createdAt   DateTime  @default(now())

  @@unique([physicianId, date])
  @@index([physicianId])
  @@index([date])
}

model ScheduleMonth {
  id           String           @id @default(cuid())
  year         Int
  month        Int // 1-12
  status       ScheduleStatus   @default(DRAFT)
  // Per-month coverage overrides: { "<shiftTemplateId>": slotsPerDay }.
  // A template listed here uses that count every day of the month instead
  // of its own weekday/holiday counts.
  coverageOverrides Json      @default("{}")
  createdAt    DateTime         @default(now())
  generatedAt  DateTime?

  assignments  ShiftAssignment[]
  runs         ScheduleGenerationRun[]

  @@unique([year, month])
}

model ShiftAssignment {
  id              String        @id @default(cuid())
  scheduleMonth   ScheduleMonth @relation(fields: [scheduleMonthId], references: [id], onDelete: Cascade)
  scheduleMonthId String

  date            DateTime // the calendar day the shift starts (date-only, midnight UTC)
  endDate         DateTime // the calendar day the shift ends (night shifts cross midnight)
  // Template this slot came from. Null if the template was later deleted;
  // the snapshot fields below keep historical schedules intact.
  shiftTemplate   ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id], onDelete: SetNull)
  shiftTemplateId String?
  location        Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  locationId      String?
  // Snapshot of the template at generation time.
  shiftName       String
  shiftCode       String
  category        ShiftCategory
  locationName    String
  locationCode    String
  color           String        @default("cyan")
  slotIndex       Int           @default(1) // 1..N when a template has N slots that day
  startTime       String // e.g. "07:00"
  endTime         String // e.g. "17:00"

  physician       Physician?    @relation(fields: [physicianId], references: [id], onDelete: SetNull)
  physicianId     String?

  isManual        Boolean       @default(false)
  isLocked        Boolean       @default(false)
  isAutoGenerated Boolean       @default(false)
  warnings        String[]      @default([])

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([scheduleMonthId])
  @@index([date])
  @@index([physicianId, date])
}

model PhysicianAvailability {
  id          String           @id @default(cuid())
  physician   Physician        @relation(fields: [physicianId], references: [id], onDelete: Cascade)
  physicianId String
  date        DateTime
  type        AvailabilityType

  @@unique([physicianId, date, type])
  @@index([physicianId])
}

// Optional per-month overrides. Collapses cleanly into Physician defaults
// when no override row exists for a given month.
model PhysicianPreference {
  id            String   @id @default(cuid())
  physician     Physician @relation(fields: [physicianId], references: [id], onDelete: Cascade)
  physicianId   String
  year          Int
  month         Int
  desiredShifts Int?
  minShifts     Int?
  maxShifts     Int?
  notes         String?

  @@unique([physicianId, year, month])
}

model ScheduleGenerationRun {
  id              String        @id @default(cuid())
  scheduleMonth   ScheduleMonth @relation(fields: [scheduleMonthId], references: [id], onDelete: Cascade)
  scheduleMonthId String
  startedAt       DateTime      @default(now())
  finishedAt      DateTime?
  success         Boolean       @default(false)
  warnings        String[]      @default([])
  summary         Json?

  @@index([scheduleMonthId])
}

// Organization-wide settings. Single row with id = 1.
model Settings {
  id                       Int      @id @default(1)
  organizationName         String   @default("Hospitalist Group")
  // Full days off required after the last night of a block (0 = none).
  restDaysAfterNights      Int      @default(2)
  // The scheduler groups nights into blocks of about this length.
  preferredNightBlock      Int      @default(3)
  // Weekday numbers (0 = Sunday … 6 = Saturday) counted as the weekend.
  weekendDays              Int[]    @default([0, 6])
  observeUSFederalHolidays Boolean  @default(true)
  // Also treat the weekday a federal holiday is observed on as a holiday.
  includeObservedHolidays  Boolean  @default(true)
  // Built-in holiday keys to ignore, e.g. ["COLUMBUS"].
  disabledHolidays         String[] @default([])
  updatedAt                DateTime @updatedAt
}

// A hospital, campus or service line that needs coverage.
model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String // short badge, e.g. "MAIN", "N"
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  // true: every physician may work here. false: only listed physicians.
  openToAll Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shiftTemplates ShiftTemplate[]
  physicians     PhysicianLocation[]
  assignments    ShiftAssignment[]
}

// A recurring shift that needs filling, e.g. "Rounder 07:00–17:00 x10".
model ShiftTemplate {
  id           String        @id @default(cuid())
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId   String
  name         String
  code         String // short label, e.g. "R", "N1"
  category     ShiftCategory
  startTime    String // "HH:MM"; an end time at or before the start = overnight
  endTime      String
  // Slots needed per day, Sunday … Saturday (7 values).
  dailyCounts  Int[]         @default([1, 1, 1, 1, 1, 1, 1])
  // Slots needed on holidays; null = use that weekday's count.
  holidayCount Int?
  color        String        @default("cyan")
  sortOrder    Int           @default(0)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  assignments ShiftAssignment[]

  @@index([locationId])
}

model PhysicianLocation {
  physician   Physician @relation(fields: [physicianId], references: [id], onDelete: Cascade)
  physicianId String
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId  String

  @@id([physicianId, locationId])
  @@index([locationId])
}

// Custom holidays. recurring = same month/day every year.
model Holiday {
  id        String   @id @default(cuid())
  date      DateTime // date-only, midnight UTC
  name      String
  recurring Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([date])
}
